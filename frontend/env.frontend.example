# Core API target (set to your Railway backend URL in production)
VITE_API_BASE_URL=https://buysellclub-backend-production.up.railway.app

# Base path for GitHub Pages (set to "/" for user/organization pages)
VITE_BASE_PATH=/buysellclubproject

# Google OAuth
VITE_GOOGLE_CLIENT_ID=

# Google Maps (optional; required only if you switch maps to Google)
VITE_GOOGLE_MAPS_API_KEY=

